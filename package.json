{
  "name": "quicmic",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm task runner for the QuicMic Rust workspace (no JS dependencies)",
  "scripts": {
    "dev": "cargo run --release",
    "build": "cargo build --release",
    "test": "cargo test",
    "dev:mac": "pnpm run dev",
    "build:mac": "pnpm run build",
    "test:mac": "pnpm run test",
    "install:mac": "cargo build --release && bash scripts/make-app.sh",
    "build:android": "cd code/android && ./gradlew assembleDebug",
    "install:android": "bash scripts/android-install.sh"
  }
}
